<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/colorBackground"
android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingBottom="36dp">

    <!-- Top nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="20dp"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_back"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:padding="9dp" />
    </LinearLayout>

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prepare Exercise"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextDark"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvPlanName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today's Exercise"
        android:textSize="14sp"
        android:textColor="@color/colorTextMedium"
        android:layout_marginBottom="28dp" />

    <!-- Placeholder content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="60dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session preparation page"
            android:textSize="16sp"
            android:textColor="@color/colorTextMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(To be implemented)"
            android:textSize="13sp"
            android:textColor="@color/colorTextLight"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Start Session button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartSession"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Start Session"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/colorPrimaryGreen"
        app:cornerRadius="14dp" />

</LinearLayout>
</ScrollView>