<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- TITLE -->
    <TextView
        android:id="@+id/tvMappingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Connect your sensors"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1C2B4A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvMappingSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confirm which sensor corresponds to which joint before starting."
        android:textSize="14sp"
        android:textColor="#6B7A99"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvMappingTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SENSOR 1 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSensor1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvMappingSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSensor1Id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensor: AA:BB:CC:DD"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1C2B4A"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select joint:"
                android:textSize="12sp"
                android:textColor="#6B7A99"
                android:layout_marginTop="8dp"/>

            <Spinner
                android:id="@+id/spinnerSensor1Joint"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- SENSOR 2 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSensor2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/cardSensor1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSensor2Id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensor: EE:FF:GG:HH"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1C2B4A"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select joint:"
                android:textSize="12sp"
                android:textColor="#6B7A99"
                android:layout_marginTop="8dp"/>

            <Spinner
                android:id="@+id/spinnerSensor2Joint"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- CONFIRM BUTTON -->
    <Button
        android:id="@+id/btnConfirmMapping"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:text="Confirm and Start Session"
        android:backgroundTint="#1A9E8F"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/cardSensor2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CANCEL -->
    <TextView
        android:id="@+id/tvCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textSize="14sp"
        android:textColor="#6B7A99"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:layout_gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btnConfirmMapping"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>