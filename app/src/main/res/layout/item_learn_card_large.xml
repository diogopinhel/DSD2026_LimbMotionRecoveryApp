<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_learn_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <!-- Thumbnail -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="110dp">

        <View
            android:id="@+id/learnThumbBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- YouTube thumbnail (shown when video is available) -->
        <ImageView
            android:id="@+id/ivThumbYoutube"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_learn_play_btn">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_play"
                android:contentDescription="@null"
                android:tint="@color/white" />
        </FrameLayout>
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/learnTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="2dp"
        android:text="Recovery tutorial"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextDark"
        android:lineSpacingMultiplier="1.3"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Duration -->
    <TextView
        android:id="@+id/learnDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:text="5 min"
        android:textSize="10sp"
        android:textColor="@color/colorTextMedium" />

</LinearLayout>
