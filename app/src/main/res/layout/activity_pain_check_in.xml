<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9F8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_right"
                android:scaleX="-1"
                android:contentDescription="Back"
                android:tint="@color/colorTextDark" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pain Check-in"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextDark"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- REGISTER SECTION (visible when not logged today) -->
            <LinearLayout
                android:id="@+id/layoutRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_plan_card_default"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAIN CHECK-IN"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#BA7517"
                    android:letterSpacing="0.07"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How is your pain today?"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextDark"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 = no pain  ·  10 = worst possible"
                    android:textSize="11sp"
                    android:textColor="@color/colorTextMedium"
                    android:layout_marginBottom="16dp" />

                <!-- Number row 1 (1–5) -->
                <LinearLayout
                    android:id="@+id/painRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Number row 2 (6–10) -->
                <LinearLayout
                    android:id="@+id/painRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="14dp" />

                <!-- Pain scale bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="3dp">
                    <View android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="3" android:background="#1D9E75" />
                    <View android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="4" android:background="#EF9F27" />
                    <View android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="3" android:background="#E24B4A" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="No pain"
                        android:textSize="10sp" android:textColor="#1D9E75" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Moderate"
                        android:textSize="10sp" android:textColor="#BA7517" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Worst"
                        android:textSize="10sp" android:textColor="#E24B4A" android:gravity="end" />
                </LinearLayout>

                <!-- Selected level label -->
                <TextView
                    android:id="@+id/tvSelectedLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select a level above"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextMedium"
                    android:gravity="center"
                    android:layout_marginBottom="14dp" />

                <!-- Notes field -->
                <EditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Add a note (optional)..."
                    android:textSize="13sp"
                    android:textColor="@color/colorTextDark"
                    android:textColorHint="@color/colorTextMedium"
                    android:background="@drawable/bg_glance_item"
                    android:padding="12dp"
                    android:minLines="2"
                    android:maxLines="4"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:layout_marginBottom="16dp" />

                <!-- Submit button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Save Pain Level"
                    android:textColor="@color/white"
                    android:backgroundTint="#1D9E75"
                    android:enabled="false"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>

            <!-- LOCKED SECTION (visible when already logged today) -->
            <LinearLayout
                android:id="@+id/layoutLocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_plan_card_default"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓  Pain logged for today"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1D9E75"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvLockedInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextMedium"
                    android:gravity="center"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#BA7517"
                    android:gravity="center" />
            </LinearLayout>

            <!-- HISTORY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HISTORY"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextMedium"
                android:letterSpacing="0.07"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvEmptyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No pain logs yet"
                android:textSize="13sp"
                android:textColor="@color/colorTextMedium"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
